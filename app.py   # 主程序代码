def parse_tracking_numbers(content):
    """从消息中提取快递单号"""
    # 先移除@机器人的部分
    content = re.sub(r'@[^\s]+', '', content)
    
    # 移除"拦截"等触发词
    content = re.sub(r'拦截|退回|拦截退回', '', content)
    
    # 支持的分隔符：换行、逗号、顿号、空格、竖线、分号等
    pattern = r'[，,、\s\n\r\|;；]+'
    
    # 按分隔符拆分
    parts = re.split(pattern, content.strip())
    
    # 过滤空字符串，并提取纯数字（快递单号通常是纯数字）
    numbers = []
    for p in parts:
        p = p.strip()
        # 匹配8-15位纯数字（根据你的快递单号规则调整）
        if re.match(r'^\d{8,15}$', p):
            numbers.append(p)
    
    # 去重
    return list(set(numbers))


