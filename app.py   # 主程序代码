# 企业微信加解密工具类
# ============================================================

class WXBizMsgCrypt:
    def __init__(self, token, encoding_aes_key, receive_id):
        self.token = token
        self.aes_key = base64.b64decode(encoding_aes_key + "=")
        self.receive_id = receive_id
    
    def verify_url(self, msg_signature, timestamp, nonce, echostr):
        signature = self._gen_signature(timestamp, nonce, echostr)
        if signature != msg_signature:
            raise Exception("签名校验失败")
        decrypted = self._decrypt(echostr)
        return decrypted
    
    def decrypt_msg(self, msg_signature, timestamp, nonce, encrypt_msg):
        signature = self._gen_signature(timestamp, nonce, encrypt_msg)
        if signature != msg_signature:
            raise Exception("签名校验失败")
        decrypted = self._decrypt(encrypt_msg)
        return decrypted
    
    def _gen_signature(self, timestamp, nonce, encrypt):
        sort_list = [self.token, timestamp, nonce, encrypt]
        sort_list.sort()
        sha1 = hashlib.sha1("".join(sort_list).encode())
        return sha1.hexdigest()
    
    def _decrypt(self, encrypt_msg):
        cipher = AES.new(self.aes_key, AES.MODE_CBC, self.aes_key[:16])
        plain_text = cipher.decrypt(base64.b64decode(encrypt_msg))
        pad = plain_text[-1]
        content = plain_text[:-pad]
        msg_len = struct.unpack(">I", content[16:20])[0]
        msg = content[20:20+msg_len].decode("utf-8")
        receive_id = content[20+msg_len:].decode("utf-8")
        if receive_id != self.receive_id:
            raise Exception("receive_id校验失败")
        return msg


