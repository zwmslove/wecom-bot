@app.route("/wecom_callback", methods=["POST"])
def receive_message():
    msg_signature = request.args.get("msg_signature")
    timestamp = request.args.get("timestamp")
    nonce = request.args.get("nonce")
    
    body = request.get_json()
    encrypt_msg = body.get("encrypt")
    
    try:
        plain_msg = crypt.decrypt_msg(msg_signature, timestamp, nonce, encrypt_msg)
        msg_data = json.loads(plain_msg)
        
        # 只处理文本消息
        if msg_data.get("msgtype") == "text":
            content = msg_data.get("text", {}).get("content", "")
            chatid = msg_data.get("chatid", "")
            from_user = msg_data.get("from", {}).get("userid", "")
            
            logging.info(f"收到消息: 群={chatid}, 用户={from_user}, 内容={content}")
            
            # 检查是否包含"拦截"关键词
            if "拦截" in content or "退回" in content:
                # 解析快递单号
                numbers = parse_tracking_numbers(content)
                
                if numbers:
                    # 1. 转发到快递群
                    forward_to_delivery_group(numbers)
                    
                    # 2. 登记到文档
                    group_name = f"群_{chatid[-6:]}"  # 取chatid后6位作为群名
                    for num in numbers:
                        register_to_document(num, group_name, from_user)
                    
                    # 3. 回复客户
                    reply_msg = f"✅ 已收到拦截请求，共{len(numbers)}个单号，已通知快递员处理"
                    reply_to_group(chatid, reply_msg)
                else:
                    reply_to_group(chatid, "❌ 未识别到有效的快递单号，请发送格式：@机器人 1234567890 拦截")
            else:
                # 不包含关键词，静默忽略
                logging.info("消息不包含拦截关键词，忽略")
        
        return "", 200
        
    except Exception as e:
        logging.error(f"消息处理失败: {e}")
        return "处理失败", 500


